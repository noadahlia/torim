{
  "expo": {
    "name": "Torim",
    "slug": "torim-beauty-booking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "torim",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.torim.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Torim to access your location for finding nearby professionals"
      }
    },
    "android": {
      "package": "com.torim.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000",
      "firebaseProjectId": "torim"
    }
  }
}
